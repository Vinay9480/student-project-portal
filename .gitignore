# Python virtual environment
venv/
env/
ENV/
.venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env
.env.local
.env.*.local

# SQLite local database (use Vercel Postgres in cloud)
instance/*.db
instance/*.sqlite
instance/*.sqlite3

# Vercel CLI cache
.vercel/

# User uploads & cache (local only)
app/static/uploads/attachments/*
!app/static/uploads/attachments/.gitkeep

# IDE configs & logs
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db
